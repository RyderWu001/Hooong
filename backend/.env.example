# ─── 資料庫 ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ─── 服務 ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── 認證（必填）──────────────────────────────────────────
# 未設定時服務會拒絕啟動。產生方式：openssl rand -base64 32
JWT_SECRET=

# ─── 檔案儲存 ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 設為 yes 時上傳桶採私有 + 短效簽名網址。
# 既有部署切換前須注意：資料庫中已存的是完整公開網址，改為私有後那些連結會失效。
STORAGE_PRIVATE=no

# ─── AI 功能（選填）───────────────────────────────────────
# 供「AI 資料助理」與知識庫問答使用，模型跑在本機 Ollama（需先 `ollama pull qwen2.5:7b`）
# 設為 yes 可停用 AI 功能
AI_DISABLED=
# 預設值通常不用改，除非 Ollama 跑在別的主機/連接埠，或想換模型
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ─── 安全設定 ─────────────────────────────────────────────
# 正式環境請填入前端網域，多個以逗號分隔。留空 = 允許所有來源（僅適合本機開發）
CORS_ORIGIN=

# 是否開放使用者自行註冊。內部系統建議維持關閉，由管理員建立帳號
ALLOW_SELF_REGISTER=no

# 允許對正式資料庫執行 db:seed（會清空所有資料）。除非確定已備份，否則不要設定
# ALLOW_PRODUCTION_SEED=yes
